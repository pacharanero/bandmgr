<% content_for :title, "Tasks" %>

<div class="flex flex-col gap-6">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Band tasks</h1>
      <p class="mt-1 text-sm text-slate-600">Keep work visible, assign it to a band member, and track its status.</p>
    </div>
    <% if @bands.many? %>
      <%= form_with url: tasks_path, method: :get, class: "flex items-end gap-2" do |form| %>
        <div>
          <%= form.label :band_id, "Band", class: "block text-xs font-medium text-slate-600" %>
          <%= form.select :band_id, options_from_collection_for_select(@bands, :id, :name, @selected_band&.id), { include_blank: "All accessible bands" }, class: "mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <%= form.submit "Filter", class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-slate-400 hover:text-slate-900" %>
      <% end %>
    <% end %>
  </header>

  <% if @selected_band %>
    <section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Add task for <%= @selected_band.name %></h2>
      <%= form_with model: @task, class: "mt-4 grid gap-3 md:grid-cols-[minmax(0,1fr)_200px_auto] md:items-end" do |form| %>
        <%= form.hidden_field :band_id %>
        <div>
          <%= form.label :title, class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :title, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= form.label :assignee_id, "Assignee", class: "block text-sm font-medium text-slate-700" %>
          <%= form.collection_select :assignee_id, @members, :id, :email_address, { include_blank: "Unassigned" }, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <%= form.submit "Add task", class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
        <div class="md:col-span-3">
          <%= form.label :description, "Description", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_area :description, rows: 2, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </section>
  <% else %>
    <p class="rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">Join a band to create and manage its tasks.</p>
  <% end %>

  <section class="rounded-lg border border-slate-200 bg-white shadow-sm">
    <% if @tasks.any? %>
      <div class="divide-y divide-slate-200">
        <% @tasks.each do |task| %>
          <div class="p-5">
            <%= form_with model: task, class: "grid gap-3 md:grid-cols-[minmax(0,1fr)_150px_200px_auto] md:items-end" do |form| %>
              <div>
                <%= form.label :title, class: "block text-sm font-medium text-slate-700" %>
                <%= form.text_field :title, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                <p class="mt-1 text-xs text-slate-500"><%= task.band.name %> · Created by <%= task.creator.email_address %></p>
              </div>
              <div>
                <%= form.label :status, class: "block text-sm font-medium text-slate-700" %>
                <%= form.select :status, Task.statuses.keys.map { |status| [status.humanize, status] }, {}, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
              </div>
              <div>
                <%= form.label :assignee_id, "Assignee", class: "block text-sm font-medium text-slate-700" %>
                <%= form.collection_select :assignee_id, task.band.users.order(:email_address), :id, :email_address, { include_blank: "Unassigned" }, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
              </div>
              <%= form.submit "Save", class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-slate-400 hover:text-slate-900" %>
              <div class="md:col-span-4">
                <%= form.label :description, "Description", class: "block text-sm font-medium text-slate-700" %>
                <%= form.text_area :description, rows: 2, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
              </div>
            <% end %>
            <div class="mt-5 border-t border-slate-200 pt-4">
              <%= render "comments/comments", commentable: task, comments: task.comments.includes(:user).order(created_at: :asc) %>
              <%= button_to "Delete task", task_path(task), method: :delete, data: { turbo_confirm: "Delete this task and its comments?" }, class: "mt-3 rounded-md border border-red-200 px-3 py-2 text-xs font-semibold text-red-600 hover:border-red-300" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="p-5 text-sm text-slate-600">No tasks match this view.</p>
    <% end %>
  </section>
</div>
