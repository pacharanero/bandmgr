<section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Comments</h2>
  <% if comments.any? %>
    <div class="mt-4 space-y-4">
      <% comments.each do |comment| %>
        <article class="border-l-2 border-slate-200 pl-3 text-sm">
          <p class="text-xs text-slate-500"><%= comment.user.email_address %> · <%= l(comment.created_at, format: :short) %></p>
          <p class="mt-1 text-slate-700"><%= comment.body %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-slate-600">No comments yet.</p>
  <% end %>

  <%= form_with url: comments_path, scope: :comment, class: "mt-5 border-t border-slate-200 pt-4" do |form| %>
    <%= hidden_field_tag :commentable_type, commentable.class.name %>
    <%= hidden_field_tag :commentable_id, commentable.id %>
    <%= form.label :body, "Add a comment", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :body, rows: 3, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    <%= form.submit "Add comment", class: "mt-3 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
  <% end %>
</section>
