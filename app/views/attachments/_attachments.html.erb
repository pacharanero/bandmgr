<section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Attachments</h2>
  <% if record.attachments.attached? %>
    <ul class="mt-3 space-y-2 text-sm">
      <% record.attachments.each do |attachment| %>
        <li class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-slate-200 px-3 py-2">
          <div>
            <%= link_to attachment.filename.to_s, attachment_path(attachment), class: "font-medium text-slate-700 underline hover:text-slate-900" %>
            <span class="ml-2 text-xs text-slate-500"><%= number_to_human_size(attachment.byte_size) %></span>
          </div>
          <% if policy(record).update? %>
            <%= button_to "Remove", attachment_path(attachment), method: :delete, data: { turbo_confirm: "Remove this attachment?" }, class: "rounded-md border border-red-200 px-3 py-1 text-xs font-semibold text-red-600 hover:border-red-300" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-slate-600">No attachments yet.</p>
  <% end %>
</section>
