#!/usr/bin/env bash
# Run Rails and dependency security scans in the development Compose stack.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

compose_file="docker-compose.yml"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required to run this script."
  exit 1
fi

# Install into the named bundle cache so the script works after runtime updates.
exec docker compose -f "${compose_file}" run --rm web bash -lc "bundle install && bundle exec brakeman --no-pager && bundle exec bundler-audit check --update && bin/importmap audit"
