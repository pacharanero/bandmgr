#!/usr/bin/env bash
# Recreate the local development database. This destroys local data.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

compose_file="docker-compose.dev.yml"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required to run this script."
  exit 1
fi

if ! docker compose -f "${compose_file}" ps --status running web >/dev/null 2>&1; then
  echo "The web container is not running. Start it first (s/dev)."
  exit 1
fi

echo "== Resetting database =="
docker compose -f "${compose_file}" exec -T web bin/rails db:drop db:create db:migrate
