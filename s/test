#!/usr/bin/env bash
# Run the complete Rails unit and system test suite in the development Compose stack.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

compose_file="docker-compose.dev.yml"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required to run this script."
  exit 1
fi

# Install into the named bundle cache so the script works after runtime updates.
exec docker compose -f "${compose_file}" run --rm \
  -e RAILS_ENV=test \
  -e DATABASE_URL=postgres://bandmgr:bandmgr@db:5432/bandmgr_test \
  web bash -lc "bundle install && bundle exec rails db:test:prepare test test:system"
